---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
// Self-hosted rather than a Google Fonts CDN link, consistent with the Core repo's Portal/
// Admin apps (see portal/src/main.tsx) — no external font-loading dependency for a "reference
// production" site meant to demonstrate good defaults.
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/noto-serif-jp/400.css";
import "@fontsource/noto-serif-jp/600.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown>[];
}

const { title, description, path = "/", structuredData = [] } = Astro.props;
const siteUrl = "https://akinael-ai.com";
const canonical = new URL(path, siteUrl).toString();
const ogImage = new URL("/assets/screenshots/public-home.png", siteUrl).toString();
const gaMeasurementId = "G-HMHXGL2ZJ7";
// Defensively escape "<" so a data value can never terminate the script tag early
// (e.g. a value containing "</script>"), even though current sources are all
// author-controlled content, not user input.
const toSafeJsonLd = (value: Record<string, unknown>) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="アキナエルAI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="アキナエルAI 公開サイト" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="アキナエルAI 公開サイト" />
    <link rel="icon" href="/assets/logos/favicon.svg" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", gaMeasurementId, { anonymize_ip: true });
      window.akinaelTrack = function (eventName, params = {}) {
        window.gtag("event", eventName, params);
      };
    </script>
    {structuredData.map((entry) => (
      <script type="application/ld+json" is:inline set:html={toSafeJsonLd(entry)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("a,button") : null;
        if (!target || !(target instanceof HTMLElement) || !window.akinaelTrack) return;

        const href = target instanceof HTMLAnchorElement ? target.getAttribute("href") || "" : "";
        const label = (target.textContent || "").trim().replace(/\s+/g, " ").slice(0, 120);

        if (href.includes("/portal/")) {
          window.akinaelTrack("portal_click", { link_text: label, link_url: href, page_path: location.pathname });
        }
        if (label.includes("AIに相談") || label.includes("無料でAIに相談")) {
          window.akinaelTrack("consultation_cta_click", { link_text: label, link_url: href, page_path: location.pathname });
        }
      });
    </script>
  </body>
</html>
