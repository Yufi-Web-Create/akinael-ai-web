---
const coreOrigin = (import.meta.env.PUBLIC_CORE_ORIGIN || "https://akinael-ai.com").replace(/\/+$/, "");
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>パスワード再設定 | アキナエルAI</title>
  </head>
  <body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f7f3ea;color:#17302e;">
      <p>パスワード再設定画面へ移動しています…</p>
    </main>
    <script define:vars={{ coreOrigin }}>
      const target = `${coreOrigin}/portal/?mode=recovery${window.location.hash || ""}`;
      window.location.replace(target);
    </script>
  </body>
</html>
