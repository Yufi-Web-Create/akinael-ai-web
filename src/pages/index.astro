---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegisterWidget from "../components/RegisterWidget.astro";

const painPoints = [
  { title: "更新する人がいない", description: "Webサイトやお知らせを直したくても、社内に担当できる人がいません。" },
  { title: "頼れる先が見つからない", description: "小さなお店・事業の規模に合う、気軽に相談できる制作の頼み先が見つかりません。" },
  { title: "AIを使いこなせない", description: "AIが便利そうなのは分かっていても、何をどう頼めばよいのか分かりません。" },
];

const values = [
  { title: "普段の言葉で相談できる", description: "専門用語や仕様書は不要です。困りごとをそのまま話してください。" },
  { title: "契約前に試作を見られる", description: "見積りだけで進めず、試作を確認してから契約を検討できます。" },
  { title: "小さな商いにやさしい価格", description: "お試しは0円。月額プランも小規模店舗・地域事業者に合わせた価格です。" },
  { title: "作る工程と確かめる工程を分離", description: "制作する工程と検査する工程を分け、品質を確認してから次へ進めます。" },
  { title: "公開・課金は人が確認", description: "元に戻しにくい操作は、AIだけで自動実行せず人の承認を必須にしています。" },
  { title: "継続的な改善も相談できる", description: "作って終わりではなく、契約プランに応じて公開後の改善も続けて相談できます。" },
];

const offerings = [
  { kicker: "相談", title: "AI相談・集客相談", description: "経営や集客の困りごとを、普段の言葉でAIに相談できます。" },
  { kicker: "文章", title: "SNS投稿案・キャッチコピー", description: "投稿文やキャッチコピー、案内文の下書きを作成します。" },
  { kicker: "Web", title: "Webサイト・LP制作・改善", description: "既存サイトの部分修正から、新規制作・公開まで対応します。" },
  { kicker: "デザイン", title: "チラシ・バナー制作", description: "チラシやSNS用バナーなど、必要な販促物を相談できます。" },
  { kicker: "調査", title: "簡易リサーチ・施策提案", description: "競合や地域情報を調べ、実行できる施策を提案します。" },
  { kicker: "運用", title: "継続的な制作・運用支援", description: "公開後の更新・改善・分析まで、契約プランに応じて継続支援します。" },
];

const flow = [
  { title: "AIに相談", body: "困っていること、やってみたいことを、普段の言葉でチャットに伝えます。" },
  { title: "内容整理", body: "AIが相談内容を整理し、必要な作業内容へまとめます。" },
  { title: "AIによる提案・制作", body: "整理した内容をもとに、AIが提案・制作を進めます。" },
  { title: "プレビュー確認", body: "できあがった内容を、実際の画面で確認できます。" },
  { title: "修正", body: "気になる点があれば、そのままAIに修正を相談できます。" },
  { title: "人による承認", body: "公開・課金など重要な操作の前には、必ず人が内容を確認します。" },
  { title: "公開・利用", body: "承認後に公開・利用を開始し、その後も改善を相談できます。" },
];

const slides = [
  { src: "/assets/lp/01-home.png", alt: "アキナエルAI お客様マイページのホーム画面" },
  { src: "/assets/lp/02-chat.png", alt: "アキナエルAI AIに相談する画面" },
  { src: "/assets/lp/03-summary.png", alt: "アキナエルAI 相談内容の確認画面" },
  { src: "/assets/lp/04-works.png", alt: "アキナエルAI 制作物の確認画面" },
  { src: "/assets/lp/05-plan.png", alt: "アキナエルAI プランとお支払い画面" },
  { src: "/assets/lp/06-settings.png", alt: "アキナエルAI 設定画面" },
];

const pricingSupport = [
  { plan: "TRY", name: "お試し", amount: "¥0", note: "簡易相談、集客案、SNS案、簡易リサーチ、簡易試作。" },
  { plan: "MINI", name: "本契約ミニ", amount: "¥3,980 / 月", note: "日常の相談、文章制作、簡易調査、少量の画像素材。" },
  { plan: "GROW", name: "しっかり運用", amount: "¥7,980 / 月", note: "Web、SNS、SEO、競合、アクセスの継続改善。" },
  { plan: "ADVANCED", name: "発展運用", amount: "¥17,800 / 月", note: "高度な分析、自動化、業務改善、広告運用の利用資格。" },
];

const pricingMenu = [
  { plan: "WEB", name: "Web正式制作・公開", amount: "¥19,800〜", note: "最大5ページ程度、スマホ対応、基本SEO、問い合わせフォームなど。" },
  { plan: "ADS", name: "Instagram広告運用", amount: "広告費の20%", note: "最低¥5,500 / 月。戦略立案からクリエイティブ、配信、効果確認まで。" },
];

const structuredData = [{
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "アキナエルAI",
  url: "https://akinael-ai.com/",
  description: "商いの願いを叶えるAI。小さな店舗・地域事業者のWeb・SNS・文章・画像の相談から制作、継続改善まで対応します。",
  logo: "https://akinael-ai.com/assets/logos/logo-horizontal.svg",
}];
---

<BaseLayout
  title="アキナエルAI｜商いの願いを、AIが叶えます。"
  description="小さな店舗・地域事業者のためのAI相談役。Webサイト、SNS、文章、画像、調査をチャットで相談し、無料の試作を確認してから契約を検討できます。"
  path="/"
  structuredData={structuredData}
>
  <main class="lp-root">
    <section class="lp-hero" aria-labelledby="hero-title">
      <div class="container lp-hero-inner">
        <h1 id="hero-title" class="lp-hero-title">
          <span class="cmyk" data-text="商いの願いを、">商いの願いを、</span>
          <span class="cmyk" data-text="AIが叶えます。">AIが叶えます。</span>
        </h1>
        <p class="lp-hero-copy">Web担当者がいない小さなお店・地域事業者のためのAI相談役です。Webサイト、SNS、文章、画像、調査のことを、普段の言葉で相談しながら形にできます。</p>
        <div class="lp-actions">
          <a class="button button-primary" href="#register">AIに相談してみる</a>
          <a class="button lp-button-ghost" href="#pricing">料金を見る</a>
        </div>
      </div>
    </section>

    <section class="section lp-pain" aria-labelledby="pain-title">
      <div class="container">
        <p class="eyebrow">こんなお困り、ありませんか？</p>
        <h2 id="pain-title" class="sr-only">よくあるお困りごと</h2>
        <div class="lp-pain-grid">
          {painPoints.map((item) => (
            <article><h3>{item.title}</h3><p>{item.description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="difference" class="section" aria-labelledby="value-title">
      <div class="container lp-value-frame">
        <div class="lp-value-heading">
          <p class="eyebrow">WHY AKINAEL</p>
          <h2 id="value-title">小さな商いのために、最初から設計しています。</h2>
        </div>
        <div class="lp-value-grid">
          {values.map((item, index) => (
            <article class="lp-value-item">
              <span class="lp-num">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="service" class="section" aria-labelledby="offer-title">
      <div class="container">
        <div class="section-head"><p class="eyebrow">できること</p><h2 id="offer-title">相談から制作・運用まで、まとめておまかせ</h2></div>
        <div class="lp-offer-grid">
          {offerings.map((item) => (
            <article class="lp-card"><p class="lp-card-kicker">{item.kicker}</p><h3>{item.title}</h3><p>{item.description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="flow-title">
      <div class="container lp-flow-layout">
        <div>
          <div class="section-head"><p class="eyebrow">ご利用の流れ</p><h2 id="flow-title">話すところから、公開まで。</h2></div>
          <ol class="lp-flow-steps">
            {flow.map((item, index) => (
              <li><span class="lp-step-num">{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>
            ))}
          </ol>
          <p class="lp-flow-note">公開や課金の前には、必ず人の目で確認します。</p>
        </div>
        <div class="lp-halftone-shell" aria-label="アキナエルAIの実際の画面">
          <div class="lp-slider" data-slider>
            {slides.map((slide, index) => (
              <img src={slide.src} alt={slide.alt} class:list={{ "is-active": index === 0 }} loading={index === 0 ? "eager" : "lazy"} />
            ))}
            <div class="lp-slider-dots" aria-label="画面を切り替える">
              {slides.map((slide, index) => (
                <button type="button" class:list={{ "is-active": index === 0 }} aria-label={`${index + 1}枚目: ${slide.alt}`} aria-pressed={index === 0 ? "true" : "false"} data-slide-index={index}></button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head"><p class="eyebrow">料金</p><h2 id="pricing-title">必要な分だけ、分かりやすく。</h2></div>
        <fieldset class="lp-seg" data-pricing-toggle>
          <legend class="sr-only">料金表示</legend>
          <label><input type="radio" name="pricing-view" value="support" checked /> <span>継続サポートプラン</span></label>
          <label><input type="radio" name="pricing-view" value="menu" /> <span>単体メニュー</span></label>
        </fieldset>
        <div data-pricing-panel="support" class="lp-pricing-grid">
          {pricingSupport.map((item) => (
            <article class="lp-price-card"><p class="lp-card-kicker">{item.plan}</p><h3>{item.name}</h3><p class="lp-price">{item.amount}</p><p>{item.note}</p></article>
          ))}
        </div>
        <div data-pricing-panel="menu" class="lp-pricing-grid lp-pricing-grid-menu" hidden>
          {pricingMenu.map((item) => (
            <article class="lp-price-card"><p class="lp-card-kicker">{item.plan}</p><h3>{item.name}</h3><p class="lp-price">{item.amount}</p><p>{item.note}</p></article>
          ))}
        </div>
        <div class="lp-price-notes">
          <p>外部サービス費・広告費・ドメイン費などは、必要な場合のみ別途お客様負担です。</p>
          <p>プラン外の作業は、内容と料金をご確認いただき、承認後に開始します。</p>
          <p>承認前に、無断で課金・公開を行うことはありません。</p>
        </div>
      </div>
    </section>

    <section class="section lp-final-cta" aria-labelledby="cta-title">
      <div class="container"><h2 id="cta-title">まずは無料で、相談してみませんか？</h2><p>やりたいことがまだ曖昧でも大丈夫です。普段の言葉で、今のお困りごとから教えてください。</p><a class="button button-primary" href="#register">AIに相談してみる</a></div>
    </section>
  </main>

  <dialog class="lp-register-dialog" data-register-dialog aria-labelledby="register-title">
    <div class="lp-dialog-inner" id="register">
      <button type="button" class="lp-dialog-close" data-close-register aria-label="閉じる">×</button>
      <p class="eyebrow">FREE CONSULTATION</p>
      <h2 id="register-title">無料でAIに相談する</h2>
      <p class="muted">アカウントを作成すると、そのまま相談を始められます。</p>
      <RegisterWidget id="register-widget" />
    </div>
  </dialog>

  <script>
    const slider = document.querySelector<HTMLElement>("[data-slider]");
    if (slider) {
      const images = Array.from(slider.querySelectorAll<HTMLImageElement>("img"));
      const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>("[data-slide-index]"));
      let active = 0;
      let timer: number | undefined;
      const show = (next: number) => {
        active = next;
        images.forEach((image, index) => image.classList.toggle("is-active", index === active));
        dots.forEach((dot, index) => { dot.classList.toggle("is-active", index === active); dot.setAttribute("aria-pressed", index === active ? "true" : "false"); });
      };
      const start = () => { timer = window.setInterval(() => show((active + 1) % images.length), 3500); };
      const restart = () => { if (timer) window.clearInterval(timer); start(); };
      dots.forEach((dot) => dot.addEventListener("click", () => { show(Number(dot.dataset.slideIndex || 0)); restart(); }));
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
    }

    const pricingInputs = document.querySelectorAll<HTMLInputElement>("input[name='pricing-view']");
    const pricingPanels = document.querySelectorAll<HTMLElement>("[data-pricing-panel]");
    pricingInputs.forEach((input) => input.addEventListener("change", () => { pricingPanels.forEach((panel) => { panel.hidden = panel.dataset.pricingPanel !== input.value; }); }));

    const dialog = document.querySelector<HTMLDialogElement>("[data-register-dialog]");
    document.querySelectorAll<HTMLAnchorElement>('a[href="#register"]').forEach((link) => {
      link.addEventListener("click", (event) => {
        if (!dialog) return;
        event.preventDefault();
        dialog.showModal();
        (window as Window & { akinaelTrack?: (name: string, payload?: Record<string, unknown>) => void }).akinaelTrack?.("consultation_cta_click", { page_path: window.location.pathname });
      });
    });
    document.querySelector<HTMLButtonElement>("[data-close-register]")?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>

<style>
  .lp-root { overflow: clip; }
  .lp-hero { padding-block: clamp(70px, 11vw, 145px) clamp(70px, 10vw, 120px); }
  .lp-hero-inner { max-width: 980px; }
  .lp-hero-title { font-size: clamp(48px, 8.4vw, 104px); line-height: .98; letter-spacing: -.045em; margin: 0; max-width: 10.8ch; }
  .lp-hero-title .cmyk { position: relative; display: block; isolation: isolate; }
  .lp-hero-title .cmyk::before, .lp-hero-title .cmyk::after { content: attr(data-text); position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .lp-hero-title .cmyk::before { color: #0088b0; transform: translate(-3px, 2px); mix-blend-mode: multiply; }
  .lp-hero-title .cmyk::after { color: #d6006c; transform: translate(3px, -2px); mix-blend-mode: multiply; }
  .lp-hero-copy { margin-top: 34px; max-width: 44rem; font-size: clamp(17px, 2vw, 21px); color: #4d4948; }
  .lp-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .lp-button-ghost { background: transparent; color: #201e1d; border-color: #bcb9b8; }
  .lp-button-ghost:hover { border-color: #0088b0; color: #006786; }
  .lp-pain { padding-top: 30px; }
  .lp-pain-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); margin-top: 25px; }
  .lp-pain-grid article { padding-top: 18px; border-top: 1px solid #bdbab9; }
  .lp-pain-grid p { color: #5f5c5b; }
  .lp-value-frame { border-top: 5px solid #201e1d; border-bottom: 1px solid #201e1d; padding-top: 12px; padding-bottom: 40px; }
  .lp-value-heading { border-top: 1px solid #201e1d; padding-top: 34px; margin-bottom: 35px; max-width: 760px; }
  .lp-value-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 50px; }
  .lp-value-item { display: grid; grid-template-columns: 64px 1fr; gap: 14px; padding-block: 24px; border-top: 1px solid #d0cecd; }
  .lp-num, .lp-step-num { color: #0088b0; font-variant-numeric: tabular-nums; font-size: 21px; }
  .lp-value-item p, .lp-flow-steps p, .lp-card > p:last-child, .lp-price-card > p:last-child { color: #5f5c5b; }
  .lp-offer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .lp-card, .lp-price-card { background: #eae9e9; border: 1px solid #d8d6d5; border-radius: 2px; padding: 25px; box-shadow: 0 2px 8px rgb(32 30 29 / .07); }
  .lp-card-kicker { margin-bottom: 10px; color: #006786; font-size: 12px; letter-spacing: .1em; font-weight: 600; text-transform: uppercase; }
  .lp-flow-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(40px, 7vw, 90px); align-items: start; }
  .lp-flow-steps { list-style: none; margin: 0; padding: 0; }
  .lp-flow-steps li { display: grid; grid-template-columns: 54px 1fr; gap: 14px; padding: 17px 0; border-top: 1px solid #d0cecd; }
  .lp-flow-steps h3 { margin-bottom: 3px; }
  .lp-flow-note { margin-top: 18px; font-size: 14px; font-weight: 600; }
  .lp-halftone-shell { position: sticky; top: 120px; padding: 18px; background-image: radial-gradient(circle, rgb(32 30 29 / .15) .8px, transparent .9px); background-size: 5px 5px; }
  .lp-slider { position: relative; aspect-ratio: 924 / 540; overflow: hidden; background: #fff; border: 1px solid #bdbab9; }
  .lp-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.1s ease; }
  .lp-slider img.is-active { opacity: 1; }
  .lp-slider-dots { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); display: flex; gap: 7px; }
  .lp-slider-dots button { width: 9px; height: 9px; border-radius: 50%; padding: 0; border: 1px solid #201e1d; background: #f3f2f2; cursor: pointer; }
  .lp-slider-dots button.is-active { background: #201e1d; }
  .lp-seg { display: inline-flex; gap: 4px; margin: 0 0 32px; padding: 4px; border: 1px solid #c7c4c3; border-radius: 2px; }
  .lp-seg label { position: relative; cursor: pointer; }
  .lp-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .lp-seg span { display: block; padding: 9px 15px; border-radius: 1px; font-size: 14px; font-weight: 600; }
  .lp-seg input:checked + span { background: #201e1d; color: #fff; }
  .lp-seg input:focus-visible + span { outline: 2px solid #0088b0; outline-offset: 2px; }
  .lp-pricing-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; }
  .lp-pricing-grid-menu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lp-price { font-size: clamp(25px, 3vw, 35px); line-height: 1.1; font-weight: 600; margin: 18px 0 14px; }
  .lp-price-notes { margin-top: 25px; max-width: 780px; font-size: 13px; color: #5f5c5b; }
  .lp-price-notes p { margin: 4px 0; }
  .lp-final-cta { padding-block: clamp(80px, 12vw, 145px); }
  .lp-final-cta .container { max-width: 820px; text-align: center; }
  .lp-final-cta h2 { font-size: clamp(33px, 5vw, 56px); }
  .lp-final-cta p { max-width: 620px; margin: 18px auto 28px; color: #5f5c5b; }
  .lp-register-dialog { width: min(94vw, 640px); border: 1px solid #201e1d; border-radius: 2px; padding: 0; background: #f3f2f2; color: #201e1d; }
  .lp-register-dialog::backdrop { background: rgb(32 30 29 / .58); }
  .lp-dialog-inner { position: relative; padding: clamp(25px, 5vw, 42px); }
  .lp-dialog-close { position: absolute; right: 16px; top: 12px; border: 0; background: transparent; font-size: 28px; cursor: pointer; }
  .lp-register-dialog :global(.register-widget form) { display: grid; gap: 12px; margin-top: 20px; }
  .lp-register-dialog :global(.register-widget input[type="email"]), .lp-register-dialog :global(.register-widget input[type="password"]) { width: 100%; padding: 13px 14px; border: 1px solid #bdbab9; border-radius: 1px; background: #fff; font: inherit; }
  .lp-register-dialog :global(.register-consent) { display: flex; align-items: flex-start; gap: 9px; font-size: 13px; }
  .lp-register-dialog :global([data-register-status]) { min-height: 1.6em; font-size: 13px; }
  @media (max-width: 960px) { .lp-offer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lp-flow-layout { grid-template-columns: 1fr; } .lp-halftone-shell { position: static; } .lp-pricing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .lp-pain-grid, .lp-value-grid, .lp-offer-grid, .lp-pricing-grid, .lp-pricing-grid-menu { grid-template-columns: 1fr; } .lp-value-item { grid-template-columns: 48px 1fr; } .lp-hero { padding-top: 58px; } .lp-hero-title { font-size: clamp(43px, 14vw, 68px); } .lp-seg { display: grid; width: 100%; } .lp-seg span { text-align: center; } }
  @media (prefers-reduced-motion: reduce) { .lp-slider img { transition: none; } }
</style>
