---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegisterWidget from "../components/RegisterWidget.astro";
import "../styles/lp.css";

const painPoints = [
  { title: "更新する人がいない", description: "Webサイトを更新できていない、SNS投稿を考える時間がない、チラシや画像を作れる人がいない。そんなお店・事業者様は少なくありません。" },
  { title: "頼れる先が見つからない", description: "外注費は高いし、制作会社に頼めるほど要件も固まっていない。専任の担当者を雇う余裕もない、というのが本音ではないでしょうか。" },
  { title: "AIを使いこなせない", description: "AIが便利そうなのは分かるけれど、使い方もプロンプトの考え方も分からない。そのまま手つかずになっていませんか。" },
];

const values = [
  "あなたの言葉で相談できる",
  "専門知識やプロンプト作成は不要",
  "相談内容をAIが整理",
  "必要な制作物・施策を具体化",
  "実際の制作物まで形にする",
  "実物を直接確認",
];

const offerings = [
  { kicker: "相談", title: "AI相談・集客相談", description: "何から始めればいいか分からない状態からでも、AIに相談しながら集客のヒントを一緒に整理します。" },
  { kicker: "発信", title: "SNS投稿案・キャッチコピー", description: "話した内容から、投稿文やキャッチコピーの案をAIが作成します。" },
  { kicker: "Web", title: "Webサイト・LP制作／改善", description: "新しく作るのはもちろん、今あるサイトの改善提案にも対応します。" },
  { kicker: "画像", title: "チラシ・バナー制作", description: "紙のチラシからSNS用バナーまで、画像制作をおまかせいただけます。" },
  { kicker: "調査", title: "簡易リサーチ・施策提案", description: "簡単な調査から、キャンペーンや施策のアイデアづくりまでご相談いただけます。" },
  { kicker: "継続", title: "継続的な制作・運用支援", description: "作って終わりにせず、継続した制作・改善までサポートします。" },
];

const flow = ["AIに相談", "内容整理", "AIによる提案・制作", "プレビュー確認", "修正", "人による承認", "公開・利用"];

const slides = [
  { src: "/assets/screenshots/lp-01-home.png", alt: "アキナエルAI お客様マイページのホーム画面" },
  { src: "/assets/screenshots/lp-02-chat.png", alt: "AIに相談する画面" },
  { src: "/assets/screenshots/lp-03-summary.png", alt: "相談内容を確認する画面" },
  { src: "/assets/screenshots/lp-04-works.png", alt: "制作物を確認する画面" },
  { src: "/assets/screenshots/lp-05-plan.png", alt: "プランとお支払いの画面" },
  { src: "/assets/screenshots/lp-06-settings.png", alt: "設定画面" },
];

const pricingSupport = [
  { name: "お試し", price: "¥0", description: "AI相談・簡易集客相談・SNS投稿案・キャッチコピー・簡易Web改善提案・簡易リサーチ・簡易Web試作。利用量・作業量には上限があります。", meta: "実際の成果物を見てから、本契約を判断できます" },
  { name: "本契約ミニ", price: "¥3,980", unit: "／月", description: "小規模な相談・制作を継続して依頼したい事業者様向け。" },
  { name: "しっかり運用", price: "¥7,980", unit: "／月", description: "SNSやWebなどを継続的に制作・改善していきたい事業者様向け。" },
  { name: "発展運用", price: "¥17,800", unit: "／月", description: "より幅広い制作・運用・集客施策まで任せたい事業者様向け。" },
];

const pricingMenu = [
  { name: "Web正式制作・公開", price: "¥19,800〜", description: "無料試作とは別に、本番用Webサイトとして正式に制作・公開する場合の料金です。" },
  { name: "Instagram広告運用", price: "広告費の20%", description: "最低5,500円／月。広告費は別途ご負担いただきます。発展運用プランでの対応が基本です。" },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "アキナエルAI",
    url: "https://akinael-ai.com/",
    description: "商いの願いを叶えるAI。小さな店舗・地域事業のWeb・SNS・文章・画像の相談から制作、継続改善まで対応します。",
    logo: "https://akinael-ai.com/assets/logos/logo-horizontal.svg",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "アキナエルAI",
    serviceType: "小規模店舗・地域事業者向けAI制作・運用支援",
    provider: { "@type": "Organization", name: "アキナエルAI" },
    areaServed: "JP",
    url: "https://akinael-ai.com/",
  },
];
---

<BaseLayout
  title="アキナエルAI｜商いの願いを、AIが叶えます。"
  description="小さな店舗・地域事業者のためのAI相談役。Webサイト、SNS、文章、画像、調査を普段の言葉で相談し、無料の試作を確認してから契約を検討できます。"
  path="/"
  structuredData={structuredData}
>
  <div class="landing-v2">
    <section class="lp-hero">
      <h1 class="lp-hero-title">
        <span class="cmyk-head"><span class="paper">商いの願いを、</span><span class="plate plate-c" aria-hidden="true">商いの願いを、</span><span class="plate plate-m" aria-hidden="true">商いの願いを、</span><span class="plate plate-y" aria-hidden="true">商いの願いを、</span></span>
        <span class="cmyk-head"><span class="paper">AIが叶えます。</span><span class="plate plate-c" aria-hidden="true">AIが叶えます。</span><span class="plate plate-m" aria-hidden="true">AIが叶えます。</span><span class="plate plate-y" aria-hidden="true">AIが叶えます。</span></span>
      </h1>
      <p class="lp-hero-copy">むずかしい言葉やプロンプトは、いりません。あなたの言葉で相談するだけで、AIがWebサイトやSNS投稿、チラシまで一緒に作成します。</p>
      <div class="lp-actions">
        <a class="btn btn-primary lp-primary" href="#register">AIに相談してみる</a>
        <a class="btn btn-ghost" href="#pricing">料金を見る</a>
      </div>
    </section>

    <section class="lp-section" aria-labelledby="pain-heading">
      <p class="lp-kicker" id="pain-heading">こんなお困り、ありませんか？</p>
      <div class="lp-pain-grid">
        {painPoints.map((item) => (
          <article>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="lp-section" id="value" aria-labelledby="difference-heading">
      <div class="lp-rule-thick" aria-hidden="true"></div>
      <div class="lp-value-head">
        <span id="difference-heading">アキナエルAIが選ばれる理由</span>
        <span>普段の言葉で、そのまま相談</span>
      </div>
      <div class="lp-rule" aria-hidden="true"></div>
      <div class="lp-value-grid">
        {values.map((item, index) => (
          <p><span>{String(index + 1).padStart(2, "0")}</span>{item}</p>
        ))}
      </div>
      <div class="lp-rule" aria-hidden="true"></div>
    </section>

    <section class="lp-section" id="offer" aria-labelledby="service-heading">
      <p class="lp-kicker">できること</p>
      <h2 class="lp-section-title" id="service-heading">相談から制作・運用まで、まとめておまかせ</h2>
      <div class="lp-card-grid">
        {offerings.map((item) => (
          <article class="lp-card">
            <span class="lp-card-kicker">{item.kicker}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="lp-section lp-flow" aria-labelledby="flow-heading">
      <div>
        <p class="lp-kicker">ご利用の流れ</p>
        <h2 class="lp-flow-title" id="flow-heading">むずかしいことは、ありません</h2>
        <ol>
          {flow.map((item, index) => <li><span>{index + 1}</span>{item}</li>)}
        </ol>
        <p class="lp-flow-note">公開や課金の前には、必ず人の目で確認します。ご安心ください。</p>
      </div>
      <figure class="lp-slider" data-slider role="group" aria-label="実際のお客様マイページ画面" aria-roledescription="carousel">
        <div class="lp-slider-frame halftone">
          {slides.map((slide, index) => (
            <img src={slide.src} alt={slide.alt} class={index === 0 ? "is-active" : ""} loading={index === 0 ? "eager" : "lazy"} width="1200" height="900" />
          ))}
        </div>
        <div class="lp-slider-dots" data-slider-dots>
          {slides.map((slide, index) => (
            <button type="button" aria-label={`${slide.alt}を表示`} class={index === 0 ? "is-active" : ""} data-index={index}></button>
          ))}
        </div>
      </figure>
    </section>

    <section class="lp-section" id="pricing" aria-labelledby="pricing-heading">
      <p class="lp-kicker">料金</p>
      <h2 class="lp-section-title lp-pricing-title" id="pricing-heading">小さな商いでも、続けやすい価格に</h2>
      <div class="lp-seg" role="radiogroup" aria-label="料金の種類" data-pricing-toggle>
        <label><input type="radio" name="plan-view" value="support" checked />継続サポートプラン</label>
        <label><input type="radio" name="plan-view" value="menu" />単体メニュー</label>
      </div>
      <div class="lp-pricing-panel" data-panel="support">
        <div class="lp-pricing-grid">
          {pricingSupport.map((item) => (
            <article class="lp-card lp-price-card">
              <span class="lp-card-kicker">{item.name}</span>
              <h3>{item.price}{item.unit && <small>{item.unit}</small>}</h3>
              <p>{item.description}</p>
              {item.meta && <p class="lp-card-meta">{item.meta}</p>}
            </article>
          ))}
        </div>
      </div>
      <div class="lp-pricing-panel" data-panel="menu" hidden>
        <div class="lp-pricing-grid lp-pricing-grid-menu">
          {pricingMenu.map((item) => (
            <article class="lp-card lp-price-card">
              <span class="lp-card-kicker">{item.name}</span>
              <h3>{item.price}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
      <ul class="lp-disclaimer">
        <li>・独自ドメインなど外部サービスの費用はお客様のご負担となります。</li>
        <li>・プラン外の作業は、内容と料金をご提示し、ご承認いただいたうえで開始します。</li>
        <li>・ご承認前に、無断で課金・公開することはありません。</li>
      </ul>
    </section>

    <section class="lp-final" id="register" aria-labelledby="register-heading">
      <h2 id="register-heading">まずは無料で、相談してみませんか？</h2>
      <p>成果物を見てから、本契約を決められます。普段の言葉で話すだけで大丈夫です。</p>
      <RegisterWidget id="register-home" />
    </section>
  </div>
</BaseLayout>

<script>
  const pricingToggle = document.querySelector<HTMLElement>("[data-pricing-toggle]");
  if (pricingToggle) {
    const radios = Array.from(pricingToggle.querySelectorAll<HTMLInputElement>('input[name="plan-view"]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== radio.value; });
      });
    });
  }

  const slider = document.querySelector<HTMLElement>("[data-slider]");
  if (slider) {
    const images = Array.from(slider.querySelectorAll<HTMLImageElement>("img"));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>("[data-slider-dots] button"));
    let active = 0;
    let timer: number | undefined;
    const show = (index: number) => {
      active = index;
      images.forEach((img, i) => img.classList.toggle("is-active", i === index));
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
    };
    const start = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(() => show((active + 1) % images.length), 3500);
    };
    dots.forEach((dot) => dot.addEventListener("click", () => { show(Number(dot.dataset.index)); start(); }));
    start();
  }
</script>
