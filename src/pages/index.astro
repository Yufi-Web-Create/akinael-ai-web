---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RegisterWidget from "../components/RegisterWidget.astro";
import TransformDemo from "../components/TransformDemo.astro";
import ShowcaseGallery from "../components/ShowcaseGallery.astro";

const industries = (await getCollection("industries")).sort((a, b) => a.data.order - b.data.order);

const reassurances = [
  { title: "専門知識は不要です", body: "普段の言葉で、困っていることを伝えるだけで相談できます。" },
  { title: "まずは無料の試作から", body: "実際に作られるものを見てから、契約するかを判断できます。" },
  { title: "AIだけで勝手に公開しません", body: "公開や課金など、元に戻しにくい操作は必ず確認してから進みます。" },
];

const flow = [
  { title: "相談する", body: "お店のこと、困っていることを、普段の言葉でチャットに伝えます。" },
  { title: "試作を見る", body: "内容を整理した試作を、無料でまず確認できます。" },
  { title: "内容を確認する", body: "費用が必要な場合は、先に説明します。納得してから次に進めます。" },
  { title: "契約・制作する", body: "制作と品質の確認を分けて進め、公開前にもう一度確認します。" },
];

const pricing = [
  { plan: "TRY", name: "お試し", amount: "0", unit: "円", note: "簡易相談、集客案、SNS案、簡易リサーチ、簡易試作。" },
  { plan: "MINI", name: "本契約ミニ", amount: "3,980", unit: "円 / 月", note: "日常の相談、文章制作、簡易調査、少量の画像素材。" },
  { plan: "GROW", name: "しっかり運用", amount: "7,980", unit: "円 / 月", note: "Web、SNS、SEO、競合、アクセスの継続改善。" },
  { plan: "ADVANCED", name: "発展運用", amount: "17,800", unit: "円 / 月", note: "高度な分析、自動化、業務改善、広告運用の利用資格。" },
];

const pricingGuide = [
  { plan: "お試し", body: "まずは試作だけ見てみたい方へ" },
  { plan: "本契約ミニ", body: "SNSや小さな更新をAIに任せたい方へ" },
  { plan: "しっかり運用", body: "Web・SNS・集客まで継続して相談したい方へ" },
  { plan: "発展運用", body: "広告運用まで、しっかり任せたい方へ" },
];

const trust = [
  { title: "公開・課金の前には、必ず確認します", body: "元に戻しにくい操作は、内容を説明したうえで明確な承認をいただいてから進めます。" },
  { title: "試作を見てから、判断できます", body: "契約前に、実際に作られるものの方向性を確認できます。仕上がりが分からないまま進める不安を減らします。" },
  { title: "完成品を渡すだけでは終わりません", body: "修正は一方的に渡すのではなく、相談しながら調整できます。" },
];

const faq = [
  { q: "専門知識がなくても相談できますか？", a: "はい。今のお困りごとを普段の言葉で伝えてください。必要な情報は対話の中で整理します。" },
  { q: "AIだけで勝手に公開されませんか？", a: "公開や課金などの重要操作は人間承認が前提です。確認なしで元に戻しにくい操作を進めることはありません。" },
  { q: "料金は決まっていますか？", a: "お試しは0円。本契約ミニは月額3,980円、しっかり運用は月額7,980円、発展運用は月額17,800円です。追加作業が必要な場合は内容と料金を先に説明し、明確な承認後に開始します。相談だけで料金は発生しません。" },
  { q: "Webサイト制作はいくらですか？", a: "正式制作・公開は19,800円からです。標準は最大5ページ程度、スマートフォン対応、基本SEO、Google Map、問い合わせフォーム、公開作業など。ページ追加、予約、EC、CMSなどは個別見積りです。" },
  { q: "無料でどこまでできますか？", a: "簡易相談、集客やSNS投稿の案、簡易リサーチ、Webサイトの簡易試作までがお試し0円の範囲です。本番公開、本格的なSEO施工、継続的なSNS運用などは含まれません。" },
  { q: "勝手に料金が発生しませんか？", a: "発生しません。相談だけでは契約にならず、プラン外の作業は見積りと提案までです。作業内容、料金、対象範囲を説明し、明確な承認をいただくまで有料作業を始めません。" },
  { q: "公開前に確認できますか？", a: "はい。試作を確認し、内容に納得してから正式制作や公開へ進むかを判断できます。" },
  { q: "解約できますか？", a: "月額プランの解約条件と返金条件は契約前に明示します。現時点で未確定の条件を、このサイト上で断定することはありません。" },
  { q: "データはどう扱われますか？", a: "相談内容や顧客情報は公開ページへ埋め込まず、認証された領域で管理します。保存期間、削除方法、外部サービスへの送信範囲は、正式なプライバシーポリシーで明示します。" },
  { q: "どんな業種が対象ですか？", a: "美容室やサロン、飲食店、教室、住宅メンテナンスなどのご相談が多いですが、業種を限定しているわけではありません。Web担当者やマーケティング担当がいない小規模な店舗・事業者であれば、業種を問わずご相談いただけます。" },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "アキナエルAI",
    url: "https://akinael-ai.com/",
    description: "商いの願いを叶えるAI。小さな店舗・事業のWeb・SNS・文章・画像の相談から制作、継続改善まで対応します。",
    logo: "https://akinael-ai.com/assets/logos/logo-horizontal.svg",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<BaseLayout
  title="アキナエルAI｜商いの願いを叶えるAI（Web・SNS・画像・調査の相談役）"
  description="小さな店舗・地域事業者のためのAI相談役。Webサイト、SNS、文章、画像、調査をチャットで相談し、無料の試作を確認してから契約を検討できます。"
  path="/"
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container">
      <div class="hero-primary">
        <p class="eyebrow">FOR SMALL LOCAL BUSINESS</p>
        <h1>商いの願いを、<br /><span class="ink-underline">叶える</span>AI。</h1>
        <p class="hero-lede">
          Web担当者がいない小さなお店のために、ホームページ・SNS投稿・チラシの文章を、チャットでの相談から一緒に作ります。専門知識やパソコン作業は必要ありません。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#showcase">無料でお店の試作例を見る</a>
          <a class="text-link" href="#flow">作り方の流れを見る</a>
        </div>
      </div>
      <div class="hero-memo">
        <p class="eyebrow">よくある相談の例</p>
        <dl>
          <div><dt>お店</dt><dd>1人で運営する美容室</dd></div>
          <div><dt>困りごと</dt><dd>メニューの更新が止まっている</dd></div>
          <div><dt>相談内容</dt><dd>「料金表を直したい。写真も入れ替えたい」</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-label="ご利用にあたっての安心材料">
    <div class="container">
      <ul class="reassure-strip">
        {reassurances.map((item) => (
          <li><strong>{item.title}</strong><span>{item.body}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section transform" id="try" aria-labelledby="try-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">まずは試してみる</p>
        <h2 id="try-heading">チャットで話した内容が、この形になります。</h2>
        <p>業種を選ぶと、実際の相談からどんな試作ができるかの例をご覧いただけます。</p>
      </div>
      <TransformDemo />
    </div>
  </section>

  <section class="section" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">実際の試作例</p>
        <h2 id="showcase-heading">「なんとなく困っている」が、ここまで形になります。</h2>
        <p>相談前の状態と、実際に作られる試作のイメージです。</p>
      </div>
      <ShowcaseGallery />
      <p class="showcase-disclaimer">上記は制作イメージのサンプルです。実際の内容は、お店ごとの相談をもとにAIが作成し、公開前にご確認いただきます。</p>
    </div>
  </section>

  <section class="section" id="industries" aria-labelledby="industries-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">業種別の相談例</p>
        <h2 id="industries-heading">その業種にしか、伝わらない言葉がある。</h2>
        <p>業種ごとのお困りごとに合わせた相談内容をご覧いただけます。</p>
      </div>
      <div class="industry-tiles">
        {industries.map((entry) => (
          <a class="industry-tile" href={`/industries/${entry.id}/`}>
            <div class="industry-tile-visual" aria-hidden="true">{entry.data.name}</div>
            <div>
              <span class="eyebrow">{entry.data.heroEyebrow}</span>
              <h3>{entry.data.name}</h3>
              <p>{entry.data.heroLead}</p>
              <span class="text-link">相談例を見る →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="flow" aria-labelledby="flow-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">利用の流れ</p>
        <h2 id="flow-heading">まず試作を見る。それから決める。</h2>
        <p>契約前に制作イメージを確認できるから、仕上がりが分からないまま進める不安を減らせます。</p>
      </div>
      <ol class="flow-stepper">
        {flow.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="awning-edge" aria-hidden="true"></div>
  <section class="section band" id="pricing" aria-labelledby="pricing-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow on-dark">PRICING</p>
        <h2 id="pricing-heading">相談だけなら、0円から。</h2>
        <p>必要な範囲が見えてから選べる4段階。追加作業は先に内容と料金を説明し、明確な承認をいただいてから始めます。</p>
      </div>
      <div class="pricing-guide">
        {pricingGuide.map((item) => (
          <div class="pricing-guide-row"><b>{item.plan}</b><span>— {item.body}</span></div>
        ))}
      </div>
      <div class="pricing-grid">
        {pricing.map((item) => (
          <div class="pricing-item">
            <span class="plan">{item.plan}</span>
            <strong>{item.name}</strong>
            <strong>{item.amount}<small>{item.unit}</small></strong>
            <p>{item.note}</p>
          </div>
        ))}
      </div>
      <p class="pricing-note">表示料金はすべて税込です。Webサイト正式制作・公開は19,800円〜。相談だけでは契約になりません。プラン外の依頼は見積り・提案までで、明示承認前に有料作業や追加課金は開始しません。</p>
    </div>
  </section>

  <section class="section" aria-labelledby="trust-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">AIに任せても安心な理由</p>
        <h2 id="trust-heading">道具だけを渡すのではなく、確かめてから進める。</h2>
      </div>
      <ul class="trust-list">
        {trust.map((item) => (
          <li><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading">気になることに、先にお答えします。</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="awning-edge" aria-hidden="true"></div>
  <section class="section band final-cta" id="register">
    <div class="container">
      <p class="eyebrow on-dark">まずは、ひとことから</p>
      <h2>あなたのお店のことを聞かせてください。</h2>
      <p class="lede" style="color:rgba(247,241,228,0.82);">無料登録後、相談を始められます。カード登録は不要です。試作を見たあとで、契約するか検討できます。</p>
      <RegisterWidget id="register-home" />
    </div>
  </section>
</BaseLayout>
