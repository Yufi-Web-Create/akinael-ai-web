---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterWidget from "../../components/RegisterWidget.astro";

export async function getStaticPaths() {
  const industries = await getCollection("industries");
  return industries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const title = `${data.name}のWeb・SNS相談 | アキナエルAI`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `アキナエルAI ${data.name}向けサービス`,
    description: data.metaDescription,
    provider: { "@type": "Organization", name: "アキナエルAI" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={data.metaDescription} path={`/industries/${entry.id}/`} structuredData={structuredData}>
  <section class="hero">
    <div class="container">
      <div class="hero-primary">
        <p class="eyebrow">{data.heroEyebrow}</p>
        <h1>{data.heroHeadline}</h1>
        <p class="hero-lede">{data.heroLead}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#register">無料でAIに相談する</a>
          <a class="text-link" href="/#service">サービス全体を見る</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="challenges-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">こんな状態はありませんか</p>
        <h2 id="challenges-heading">{data.name}でよくあるお困りごと</h2>
      </div>
      <ul class="deflist cols-2" style="list-style:none;padding:0;margin:0;">
        {data.challenges.map((challenge, index) => (
          <li class="deflist-item">
            <span class="num">{String(index + 1).padStart(2, "0")}</span>
            <p style="color:var(--color-muted);">{challenge}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="offerings-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">頼めること</p>
        <h2 id="offerings-heading">{data.name}向けに整理できること</h2>
      </div>
      <div class="deflist cols-2">
        {data.offerings.map((offering, index) => (
          <div class="deflist-item">
            <span class="num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{offering.title}</h3>
            <p>{offering.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lede">
        <Content />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">よくある質問</p>
        <h2 id="faq-heading">{data.name}に関するご質問</h2>
      </div>
      <div class="faq-list">
        {data.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta" id="register">
    <div class="container">
      <p class="eyebrow">まずは、ひとことから</p>
      <h2>{data.name}のことを聞かせてください。</h2>
      <p class="lede">無料登録後、チャットで相談を始められます。カード登録は不要です。試作を見たあとで契約を検討できます。</p>
      <RegisterWidget id="register-industry" />
    </div>
  </section>
</BaseLayout>
