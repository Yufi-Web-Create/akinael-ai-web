---
import { siteConfig } from "../lib/site-config";

const coreOrigin = (import.meta.env.PUBLIC_CORE_ORIGIN || "https://akinael-ai.com").replace(/\/+$/, "");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="アキナエルAI トップ">
      <svg class="brand-mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8" />
      </svg>
      <span>アキナエルAI</span>
    </a>
    <nav class="main-nav" aria-label="メインナビゲーション">
      <ul>
        {siteConfig.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="text-link" href={`${coreOrigin}/portal/`}>ログイン</a>
      <a class="button button-primary" href={siteConfig.primaryCta.href}>{siteConfig.primaryCta.label}</a>
    </div>
  </div>
</header>
