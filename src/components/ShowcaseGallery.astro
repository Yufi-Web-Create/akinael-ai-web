---
import { industryIcons } from "../lib/industry-icons";

const cards = [
  {
    id: "beauty",
    eyebrow: "美容室・サロン",
    before: "SNSの更新が半年止まったまま、メニューも古い情報だった。",
    kind: "web" as const,
    photo: "/assets/visual/showcase-beauty-1.webp",
    photoAlt: "自然光の差し込む木と漆喰の小さな美容室（制作イメージ）",
    url: "oo-beauty.jp",
    navItems: ["ホーム", "メニュー", "アクセス"],
    tag: "SATURDAY OPEN",
    title: "くせ毛カットが得意な美容室",
    body: "土曜日の空き枠あり。メニュー・料金・スタイル写真を掲載。",
    cta: "ご予約はこちら",
  },
  {
    id: "restaurant",
    eyebrow: "カフェ・飲食店",
    before: "ランチメニューを、毎回お客様に口頭で説明していた。",
    kind: "sns" as const,
    photo: "/assets/visual/showcase-cafe-2.webp",
    photoAlt: "湯気の立つコーヒーと手作りのカフェランチ（制作イメージ）",
    handle: "oo_coffee",
    quote: "本日の\nおすすめ",
    body: "本日のランチは自家焙煎コーヒーと一緒にどうぞ。数量限定です☕",
  },
  {
    id: "school",
    eyebrow: "教室・スクール",
    before: "体験レッスンの案内を、何から書けばいいか分からなかった。",
    kind: "flyer" as const,
    photo: "/assets/visual/showcase-school-2.webp",
    photoAlt: "そろばんを使って学ぶ子どもの手元（制作イメージ）",
    tag: "体験レッスン受付中",
    title: "そろばん、はじめませんか",
    body: "少人数制・年齢問わず歓迎。まずはお気軽にご相談を。",
    contact: "TEL 000-0000-0000",
    flyerCta: "体験を予約する",
  },
  {
    id: "home-service",
    eyebrow: "住宅メンテナンス",
    before: "問い合わせフォームがなく、電話が鳴らない日が続いていた。",
    kind: "before-after" as const,
    beforePhoto: "/assets/visual/showcase-home-before.webp",
    afterPhoto: "/assets/visual/showcase-home-after.webp",
    tag: "無料見積り",
    title: "雨どい修理も対応",
    body: "見積り無料。地域密着ですばやく対応します。",
    cta: "見積りを依頼する",
  },
];
---

<div class="showcase-carousel" data-showcase-carousel>
  <div class="showcase-controls">
    <p class="showcase-swipe-hint">横にスワイプしてご覧ください →</p>
    <div class="showcase-arrows" data-showcase-arrows>
      <button type="button" class="showcase-arrow" data-showcase-prev aria-label="前の試作例を表示">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
      </button>
      <button type="button" class="showcase-arrow" data-showcase-next aria-label="次の試作例を表示">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
  <div class="showcase-scroller" data-showcase-scroller>
  {cards.map((card) => (
    <article class="showcase-card">
      <span class="eyebrow">{card.eyebrow}</span>
      <p class="showcase-before">{card.before}</p>
      <div class="showcase-after">
        {card.kind === "web" && (
          <div class="deliv-web">
            <div class="deliv-web-chrome" aria-hidden="true">
              <span></span><span></span><span></span>
              <span class="deliv-web-url">{card.url}</span>
            </div>
            <nav class="deliv-web-nav" aria-hidden="true">
              {card.navItems!.map((item) => <span>{item}</span>)}
            </nav>
            <div class="deliv-web-photo">
              <img src={card.photo} alt={card.photoAlt} width="760" height="507" loading="lazy" />
            </div>
            <div class="deliv-web-hero">
              <div class="deliv-web-header">
                <span class="deliv-web-art" aria-hidden="true" set:html={industryIcons[card.id]} />
                <p class="deliv-web-eyebrow">{card.tag}</p>
              </div>
              <h4>{card.title}</h4>
              <p class="deliv-web-body">{card.body}</p>
              <span class="deliv-web-cta">{card.cta}</span>
            </div>
          </div>
        )}
        {card.kind === "sns" && (
          <div class="deliv-sns">
            <div class="deliv-sns-head">
              <span class="deliv-sns-avatar" aria-hidden="true" set:html={industryIcons[card.id]} />
              <span class="deliv-sns-handle">{card.handle}</span>
            </div>
            <div class="deliv-sns-photo">
              <img class="deliv-sns-photo-img" src={card.photo} alt={card.photoAlt} width="760" height="507" loading="lazy" />
              <span class="deliv-sns-photo-scrim" aria-hidden="true"></span>
              <span class="deliv-sns-quote" aria-hidden="true">{card.quote!.split("\n").map((line) => <>{line}<br /></>)}</span>
            </div>
            <div class="deliv-sns-actions" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.2s-7.6-4.4-9.4-9A5 5 0 0 1 12 6.6 5 5 0 0 1 21.4 11.2c-1.8 4.6-9.4 9-9.4 9Z"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 1 1-3.4-6.5L21 4l-1 3.8A7.96 7.96 0 0 1 21 12Z"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 20 4l-4 16-5-6-6-2Z"/></svg>
            </div>
            <p class="deliv-sns-caption"><strong>{card.handle}</strong> {card.body}</p>
          </div>
        )}
        {card.kind === "flyer" && (
          <div class="deliv-flyer">
            <div class="deliv-flyer-frame">
              <img class="deliv-flyer-photo" src={card.photo} alt={card.photoAlt} width="760" height="507" loading="lazy" />
              <span class="deliv-flyer-scrim" aria-hidden="true"></span>
              <div class="deliv-flyer-header">
                <span class="deliv-flyer-icon" aria-hidden="true" set:html={industryIcons[card.id]} />
                <p class="deliv-flyer-eyebrow">{card.tag}</p>
              </div>
              <h4>{card.title}</h4>
              <span class="deliv-flyer-rule" aria-hidden="true"></span>
              <p class="deliv-flyer-body">{card.body}</p>
              <div class="deliv-flyer-footer">
                <span class="deliv-flyer-contact">{card.contact}</span>
                <span class="deliv-flyer-cta">{card.flyerCta}</span>
              </div>
            </div>
          </div>
        )}
        {card.kind === "before-after" && (
          <div class="deliv-before-after">
            <div class="deliv-before-after-images">
              <figure>
                <img src={card.beforePhoto} alt="施工前のイメージ（制作サンプル）" width="760" height="507" loading="lazy" />
                <figcaption>Before</figcaption>
              </figure>
              <figure>
                <img src={card.afterPhoto} alt="施工後のイメージ（制作サンプル）" width="760" height="507" loading="lazy" />
                <figcaption>After</figcaption>
              </figure>
            </div>
            <div class="deliv-before-after-body">
              <div class="deliv-before-after-header">
                <span class="deliv-before-after-icon" aria-hidden="true" set:html={industryIcons[card.id]} />
                <p class="deliv-before-after-eyebrow">{card.tag}</p>
              </div>
              <h4>{card.title}</h4>
              <p>{card.body}</p>
              <span class="deliv-before-after-cta">{card.cta}</span>
            </div>
          </div>
        )}
      </div>
    </article>
  ))}
  </div>
  <div class="showcase-affordance" aria-hidden="true">
    <div class="showcase-dots" data-showcase-dots>
      {cards.map((_, index) => <span class={`showcase-dot${index === 0 ? " active" : ""}`}></span>)}
    </div>
    <span class="showcase-counter" data-showcase-counter>1 / {cards.length}</span>
  </div>
</div>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-showcase-carousel]");
  if (carousel) {
    const scroller = carousel.querySelector<HTMLElement>("[data-showcase-scroller]");
    const cards = [...carousel.querySelectorAll<HTMLElement>(".showcase-card")];
    const dots = [...carousel.querySelectorAll<HTMLElement>(".showcase-dot")];
    const counter = carousel.querySelector<HTMLElement>("[data-showcase-counter]");
    const prevButton = carousel.querySelector<HTMLButtonElement>("[data-showcase-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-showcase-next]");

    if (scroller && cards.length) {
      let ticking = false;
      let activeIndex = 0;

      const updateActive = () => {
        const scrollerLeft = scroller.getBoundingClientRect().left;
        let closestIndex = 0;
        let closestDistance = Infinity;
        cards.forEach((card, index) => {
          const distance = Math.abs(card.getBoundingClientRect().left - scrollerLeft);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });
        activeIndex = closestIndex;
        dots.forEach((dot, index) => dot.classList.toggle("active", index === closestIndex));
        if (counter) counter.textContent = `${closestIndex + 1} / ${cards.length}`;

        // Disabled state is based on actual scroll position, not just the closest-card
        // index: once enough cards fit in the remaining width, scrolling to the "next"
        // card index can already be at max scrollLeft, so index-based disabling never
        // fires for "next" even though there's nothing left to scroll to.
        const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
        if (prevButton) prevButton.disabled = scroller.scrollLeft <= 1;
        if (nextButton) nextButton.disabled = scroller.scrollLeft >= maxScrollLeft - 1;
      };

      scroller.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
      });

      const scrollToIndex = (index: number) => {
        const clamped = Math.max(0, Math.min(cards.length - 1, index));
        cards[clamped].scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
      };

      prevButton?.addEventListener("click", () => scrollToIndex(activeIndex - 1));
      nextButton?.addEventListener("click", () => scrollToIndex(activeIndex + 1));

      updateActive();
    }
  }
</script>
