# Public-site runtime values go here when integrations are added.
# Do not commit secrets. Use deployment platform secrets for production values.

# Origin of the Core API / Customer Portal (Yufi-Web-Create/akinael-ai).
# The register/login widget calls PUBLIC_CORE_ORIGIN + "/api/v2/auth/*".
# Falls back to https://akinael-ai.com in code if unset.
PUBLIC_CORE_ORIGIN=https://akinael-ai.com
